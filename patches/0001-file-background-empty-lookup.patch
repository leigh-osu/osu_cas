From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Roger Leigh <roger.leigh@oregonstate.edu>
Date: Mon, 11 May 2026 00:00:00 -0700
Subject: [PATCH] file_background: handle empty migrate lookup result

When the upstream media migration has no matching row, MigrateLookup
returns an empty array. reset([]) is false, and PHP 8 emits
"Trying to access array offset on false" when indexing it with ['mid'].
Return NULL on an empty lookup instead.
---
 .../src/Plugin/migrate/process/FileBackground.php       | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/FileBackground.php b/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/FileBackground.php
index 0000000..1111111 100644
--- a/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/FileBackground.php
+++ b/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/FileBackground.php
@@ -67,7 +67,8 @@ class FileBackground extends ProcessPluginBase implements ContainerFactoryPlugin
     catch (MigrateException $e) {
       throw $e;
     }
-    return reset($destination_fid)['mid'];
+    $first = reset($destination_fid);
+    return $first ? $first['mid'] : NULL;
   }

 }
--
2.39.0