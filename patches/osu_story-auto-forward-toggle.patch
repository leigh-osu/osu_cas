 /**
+ * Whether the external-story auto-forward feature is enabled.
+ *
+ * Configurable at /admin/config/content/osu-story; defaults to enabled
+ * when the settings object has never been saved.
+ */
+function _osu_story_auto_forward_enabled(): bool {
+  return \Drupal::config('osu_story.settings')->get('auto_forward_external') ?? TRUE;
+}
+
+/**
+ * Applies the external treatment to stories that are missing it.
+ *
+ * Stories created or edited while auto forwarding was disabled have no
+ * redirect entity; called when the feature is (re-)enabled so they start
+ * forwarding too. Idempotent — stories that already have a redirect are
+ * untouched. Returns the number of stories repaired.
+ */
+function _osu_story_auto_forward_catch_up(): int {
+  $redirect_repository = \Drupal::service('redirect.repository');
+  $nids = \Drupal::database()->query(
+    "SELECT u.entity_id FROM {node__field_osu_story_external_url} u WHERE u.bundle = 'story'"
+  )->fetchCol();
+  $repaired = 0;
+  foreach ($nids as $nid) {
+    if (!empty($redirect_repository->findBySourcePath("node/$nid"))) {
+      continue;
+    }
+    $node = \Drupal\node\Entity\Node::load($nid);
+    if ($node) {
+      $node->save();
+      $repaired++;
+    }
+  }
+  return $repaired;
+}
+
