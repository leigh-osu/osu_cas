Stop hiding the page title on group canonical pages. The hide dated from
when /group/N rendered empty; CAS group pages now carry a contact-page
default display and need their heading.

diff --git a/modules/osu_groups_basic_group/osu_groups_basic_group.module b/modules/osu_groups_basic_group/osu_groups_basic_group.module
--- a/modules/osu_groups_basic_group/osu_groups_basic_group.module
+++ b/modules/osu_groups_basic_group/osu_groups_basic_group.module
@@ -45,9 +45,7 @@
  * Implements hook_preprocess_HOOK().
  */
 function osu_groups_basic_group_preprocess_page_title(&$variables) {
-  // If we are on a group entity and on the display of it, hide the title.
-  if (Drupal::routeMatch()->getParameter('group') && Drupal::routeMatch()
-    ->getRouteName() === 'entity.group.canonical') {
-    $variables['title_attributes']['class'][] = "hidden";
-  }
+  // CAS: group canonical pages render a contact-page default display and
+  // keep their title (the stock module hid it when those pages were
+  // empty).
 }
