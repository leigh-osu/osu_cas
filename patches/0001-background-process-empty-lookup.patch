Subject: [PATCH] background process plugins: handle empty migrate lookup result

When the upstream media migration has no matching row, MigrateLookup
returns an empty array. reset([]) is false, and PHP 8 emits
"Trying to access array offset on false" when indexing it with ['mid'].
Return NULL on an empty lookup instead.
---
--- a/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/EntityBackground.php	2026-05-15 23:27:37
+++ b/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/EntityBackground.php	2026-05-15 23:29:15
@@ -96,7 +96,11 @@
       catch (MigrateException $e) {
         throw $e;
       }
-      return reset($media_id)['mid'] . ",$eb_selection";
+      $first = reset($media_id);
+      if (!$first) {
+        return NULL;
+      }
+      return $first['mid'] . ",$eb_selection";
     }
     return $value;
   }
--- a/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/FileBackground.php	2026-05-15 23:27:37
+++ b/modules/paragraphs_to_layout_builder/src/Plugin/migrate/process/FileBackground.php	2026-05-15 23:29:17
@@ -67,7 +67,8 @@
     catch (MigrateException $e) {
       throw $e;
     }
-    return reset($destination_fid)['mid'];
+    $first = reset($destination_fid);
+    return $first ? $first['mid'] : NULL;
   }
 
 }
