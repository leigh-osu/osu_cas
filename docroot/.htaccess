  RewriteRule summer-workshop-2025  https://graduate.oregonstate.edu/water-resources-graduate-program/travel-and-reimbursements [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule people  https://graduate.oregonstate.edu/water-resources-graduate-program/water-resources-faculty [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule faculty-directory https://graduate.oregonstate.edu/water-resources-graduate-program/administrative-team [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule alumni  https://graduate.oregonstate.edu/water-resources-graduate-program/directory/alumni-grad-papers [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule scholarship https://graduate.oregonstate.edu/water-resources-graduate-program/scholarships [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule applicants  https://graduate.oregonstate.edu/water-resources-graduate-program/admissions-how-apply [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule donate  https://graduate.oregonstate.edu/water-resources-graduate-program/donate [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
