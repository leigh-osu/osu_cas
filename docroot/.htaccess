  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule employment-resources  https://graduate.oregonstate.edu/water-resources-graduate-program/employment-resources [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule hydro-community https://graduate.oregonstate.edu/water-resources-graduate-program/hydro-community [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule travel-and-reimbursements https://graduate.oregonstate.edu/water-resources-graduate-program/travel-and-reimbursements [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule professional-engineering-pe-licensure-information-wre-students  https://graduate.oregonstate.edu/water-resources-graduate-program/professional-engineering-pe-licensure-information-wre-students [R=permanent,L]
  RewriteCond %{HTTP_HOST} ^gradwater.oregonstate.edu [NC]
  RewriteRule (.*) https://graduate.oregonstate.edu/water-resources-graduate-program [R=permanent,L]

  RewriteCond %{HTTP_HOST} ufio\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://fpm.oregonstate.edu/$1 [R=permanent,L]

  RewriteCond %{HTTP_HOST} thinkdifferently\.liberalarts\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://liberalarts.oregonstate.edu/cla-contact-form [R=permanent,L]

  RewriteCond %{HTTP_HOST} softwarelist\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://technology.oregonstate.edu/ [R=permanent,L]

  RewriteCond %{HTTP_HOST} c2f\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://extension.oregonstate.edu/c2f [R=permanent,L]

  RewriteCond %{HTTP_HOST} digitalmeasures\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://watermarkfs.oregonstate.edu/ [R=permanent,L]

  RewriteCond %{HTTP_HOST} conferences\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://solutions.oregonstate.edu/conference-event-services [R=permanent,L]

  RewriteCond %{HTTP_HOST} marinestudies\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://maco.oregonstate.edu/ [R=permanent,L]

  RewriteCond %{HTTP_HOST} printmail\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://solutions.oregonstate.edu/production-services [R=permanent,L]

  RewriteCond %{HTTP_HOST} undergraduate\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://academicaffairs.oregonstate.edu/ [R=permanent,L]

  # Moved to Precollege
  RewriteCond %{HTTP_HOST} ail\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://precollege.oregonstate.edu/ [R=permanent,L]

  RewriteCond %{HTTP_HOST} cosey\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://precollege.oregonstate.edu/ [R=permanent,L]

  RewriteCond %{HTTP_HOST} expeditions\.oregonstate\.edu [NC]
  RewriteRule ^(.*)$ https://precollege.oregonstate.edu/ [R=permanent,L]

  RewriteCond %{HTTP_HOST} otb\.oregonstate\.edu [NC]
