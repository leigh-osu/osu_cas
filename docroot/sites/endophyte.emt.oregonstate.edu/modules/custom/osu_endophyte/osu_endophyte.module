/**
 * Implements hook_theme().
 * @param $existing
 * @param $type
 * @param $theme
 * @param $path
 * @return array
 */
function osu_endophyte_theme($existing, $type, $theme, $path) {
  return array(
    'osu_endophyte_dashboard' => [
      'template' => 'osu-endophyte-dashboard',
      'variables' => [
        'sample_arrival_pending_count' => NULL,
        'sample_tests_pending_count' => NULL,
        'sample_tests_completed_count' => NULL,
        'sample_tests_cancelled_count' => NULL,
      ]
    ],
    'osu_endophyte_sample_tracker' => [
      'template' => 'osu-endophyte-sample-tracker',
      'base hook' => 'node',
    ],
    'osu_endophyte_test_certificate' => [
      'template' => 'osu-endophyte-test-certificate',
      'base hook' => 'node',
    ],
  );
}

/**
 * Display value for certification test results
 * @param $entity_type_manager
 * @param $entity
 * @param $fields
 * @param $delta
 */
function computed_field_field_test_final_value_calc_compute($entity_type_manager, $entity, $fields, $delta) {
  if (isset($entity->field_test_final_value->value) && $entity->field_test_final_value->value != "") {
    $actual = $entity->field_test_final_value->value;
    // legacy values calc
    if ($entity->field_test_final_value->value < 0) {
      $value = "Less than " . abs($actual);
    }
    // ergot values have a different low threshold
    elseif (($entity->getType() == 'sample_test_ergot') && ($entity->field_test_final_value->value < 200)) {
      $value = "Less than 200";
    }
    // low value threshold for other tests
    elseif (($entity->getType() != 'sample_test_ergot') && ($entity->field_test_final_value->value < 100)) {
      $value = "Less than 100";
    }
    //show the actual value
    else {
      $value = $actual;
    }
    return $value;
  }
}


/**
 * Display value for pellet ergotamine tests
 * @param $entity_type_manager
 * @param $entity
 * @param $fields
 * @param $delta
 */
function computed_field_field_test_egotamine_calculation_compute($entity_type_manager, $entity, $fields, $delta) {
  $value = "";
  if (isset($entity->field_test_pellet_rep_a->value) && isset($entity->field_test_pellet_rep_b->value)) {
    if(($entity->field_test_pellet_rep_a->value < 100) && $entity->field_test_pellet_rep_b->value < 100){
      $value = "Less than 100";
    }
    else {
      $greater = max([$entity->field_test_pellet_rep_a->value, $entity->field_test_pellet_rep_b->value]);
      $calc = round(($greater/50), 0) * 50;
      if ($calc > 1000) {
        $value = "Greater than 1000";
      } else {
        $value = "~$calc";
      }
    }
  }
  return ($value);
}

/**
 * Called when a node is cloned.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being cloned.
 */
function osu_endophyte_cloned_node_alter(\Drupal\node\NodeInterface &$node) {
  // clear title for autoNodeTitle
  $node->setTitle('');
  //reset status
  $node->set('field_sample_status', array(0, array('value' => 'sample_arrival_pending')));
}

/**
 * Implements hook_node_create
 * used here for sample presets
 *
 * @param \Drupal\node\NodeInterface $node
 * @return void
 * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 */
function osu_endophyte_node_create(\Drupal\node\NodeInterface $node) {
  if ($node->getType() == 'sample') {
    $preset = \Drupal::request()->query->get('test-preset');

    // preset for "Perennial ryegrass both tests"
    if (isset($preset) && $preset == 'rye2') {
      $ev_paragraph = \Drupal::entityTypeManager()->getStorage('paragraph')->create([
        'type' => 'sample_test_ergovaline',
      ]);
      $lb_paragraph = \Drupal::entityTypeManager()->getStorage('paragraph')->create([
        'type' => 'sample_test_lolitrem_b',
      ]);
      $node->field_sample_test_ergovaline[] = $ev_paragraph;
      $node->field_sample_test_lolitrem_b[] = $lb_paragraph;
      $node->field_sample_variety = 'ryegrass_perennial';
    }

    // preset for "Tall fescue ergovaline"
    if (isset($preset) && $preset == 'tfe') {
      $ev_paragraph = \Drupal::entityTypeManager()->getStorage('paragraph')->create([
        'type' => 'sample_test_ergovaline',
      ]);
      $node->field_sample_test_ergovaline[] = $ev_paragraph;
      $node->field_sample_variety = 'tall_fescue';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph.html.twig.
 */
function osu_endophyte_preprocess_paragraph(&$variables): void {
  $paragraph = $variables['paragraph'];
  // Get the type
  $test_type = substr($paragraph->bundle(), 12);
  $certificate = $paragraph->field_test_final_ok->value;
  $parent_nodeid = $paragraph->parent_id->value;
  if($certificate) {
    $certdisplay = array();
    $certdisplay['#weight'] = -1;
    $certdisplay['#markup'] = "<div class='test-certification'><a href='/node/$parent_nodeid/certificate/$test_type' class='pdf' target='_blank'>Test Certification</a> <a href='/node/$parent_nodeid/certificate/$test_type' class='pdf'><i class='fa-solid fa-file-pdf fa-xl'></i></a></div>";
    $variables["content"]['mydisplay']=$certdisplay;
  }
}
