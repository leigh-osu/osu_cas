{#
/**
 * @file
 * Theme override to display a block.
 *
 * Available variables:
 * - plugin_id: The ID of the block implementation.
 * - label: The configured label of the block if visible.
 * - configuration: A list of the block's configuration values.
 *   - label: The configured label for the block.
 *   - label_display: The display settings for the label.
 *   - provider: The module or other provider that provided this block plugin.
 *   - Block plugin specific settings will also be stored here.
 * - content: The content of this block.
 * - attributes: array of HTML attributes populated by modules, intended to
 *   be added to the main container tag of this template.
 *   - id: A valid HTML ID and guaranteed unique.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 *
 * @see template_preprocess_block()
 */
#}
{% macro site_link(is_front, site_name) %}
  <a
    class="site-name__site-link text-decoration-none osu-text-osuorange fw-bolder {% if is_front %}site-name__site-front{% endif %}"
    href="{{ path('<front>') }}"
    rel="home">
    {% if is_front %}<h1>{% endif %}
      {{ site_name }}
      {% if is_front %}</h1>{% endif %}
  </a>
{% endmacro %}

{% import _self as macros %}

{% set classes = [
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
  'col-9',
  'col-lg-8',
  companion_logo_name == 'default' ? 'osu-logo' : companion_logo_name == 'custom-upload' ? 'logo--user-upload' : 'osu-logo osu-logo--companion',
  group_name ? 'osu-logo--in-group',
] %}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    <div{{ content_attributes.addClass('block__content', 'd-flex', 'align-items-center') }}>
      {% if site_logo %}
        {# Logo spacing lives in _cas_header_logo.scss (20px), not utilities. #}
        <div class="d-none d-lg-flex osu-logo--wide">
          <div class="osu-logo__frame">
            <a id="osu-logo-wide" class="text-decoration-none d-inline-block" href="{{ companion_logo_link }}">
              <img class="" src="{{ base_path }}{{ active_theme_path() }}/logo.svg"
                   alt="{{ companion_logo_alt|t }}"/>
            </a>
          </div>
        </div>
        <div class="d-flex d-lg-none osu-logo--crest">
          <div class="osu-logo__frame">
            <a id="osu-logo-crest" class="text-decoration-none" href="{{ companion_logo_link }}">
              <img class="" src="{{ base_path }}{{ active_theme_path() }}/assets/osu-logo-crest-only.svg"
                   alt="{{ companion_logo_alt|t }}"/>
            </a>
          </div>
        </div>
      {% endif %}
      {% if (site_logo or companion_logo_name == 'custom-upload') and site_name %}
        <div class="align-self-stretch border-start border-neutral-200 osu-logo--spacer"></div>
      {% endif %}
      {% if site_name %}
        <div class="block__content__site-name d-flex flex-column ms-4 py-2-5 lh-sm">
          {% if content.group_name_link %}
            <div class="site-name__site-line d-flex flex-wrap align-items-baseline{% if hide_group_breadcrumb %} site-name__site-line--home{% endif %}">
              <div class="site-name__site-link--wrapper">
                <a class="site-name__site-link--with-group fs-6" href="{{ path('<front>') }}"
                   rel="home">{{ site_name }}</a>
              </div>
              {# Front page (home) shows only the group-size site name -- no
                 breadcrumb marks, parent or group name. #}
              {% if not hide_group_breadcrumb %}
                {# First » always follows the site name in a group context. #}
                <span class="site-name__sep">&raquo;</span>
                {% if parent_unit_name %}
                  <div class="site-name__parent-unit--wrapper">
                    {% if parent_unit_url %}
                      <a class="site-name__parent-unit fs-6" href="{{ parent_unit_url }}">{{ parent_unit_name }}</a>
                    {% else %}
                      <span class="site-name__parent-unit fs-6">{{ parent_unit_name }}</span>
                    {% endif %}
                    {# Second » only trails the parent when a parent unit is set. #}
                    <span class="site-name__sep">&raquo;</span>
                  </div>
                {% endif %}
              {% endif %}
            </div>
            {% if not hide_group_breadcrumb %}
              <div class="site-name__group-link--wrapper">
                {{ content.group_name_link }}
              </div>
            {% endif %}
          {% elseif companion_logo_name == 'default' %}
            {% if parent_site_name and parent_site_url %}
              <div class="site-name__parent-site-link--wrapper">
                <a class="site-name__parent-site fs-6" href="{{ parent_site_url }}"
                   rel="home">{{ parent_site_name }}</a>
              </div>
              {{ macros.site_link(is_front, site_name) }}
            {% else %}
              {{ macros.site_link(is_front, site_name) }}
            {% endif %}
          {% elseif companion_logo_name == 'custom-upload' %}
            {{ macros.site_link(is_front, site_name) }}
          {% endif %}
        </div>
      {% endif %}
      {#      {{ site_slogan }} #}
    </div>
  {% endblock %}
</div>
