{#
/**
 * @file
 * Theme override for an "osu_card" content block rendered in the "picbox"
 * view mode (the cards inside an lp_picbox_grid).
 *
 * Replicates the Drupal 7 lp_picbox behaviour: the headline is overlaid on
 * top of the image in a translucent box, the link target covers the whole
 * card, and the description (body) renders below the image.
 *
 * Accessibility: D7 put the headline and the image inside one anchor, which
 * makes the link's accessible name the headline and the image's alt read
 * together ("Crop and Soil Science seedlings emerging from dry soil"). Most
 * of these alts describe the photo rather than repeat the headline, so they
 * are worth keeping as image alts -- they just do not belong in the link
 * name. When there is a headline the anchor therefore wraps only that, and
 * .picbox-link::after stretches over .picbox-media to keep the whole card
 * clickable. A card with no headline still needs the image inside the link,
 * because its alt is then the link's only accessible name.
 *
 * Suggestion provided by manzanita_theme_suggestions_block_alter():
 *   block__block_content__view_type__osu_card__picbox
 *
 * Additional variables prepared by manzanita_preprocess_block():
 * - card_url:         The link target for the whole card (string URL).
 * - card_title:       The overlay headline: the component title when
 *                     "Display title" is checked, else the link label.
 * - card_image:       Render array for field_osu_card_image (800x450).
 * - card_description: Render array for the body field.
 *
 * @see template_preprocess_block()
 * @see madrone_preprocess_block()
 * @see manzanita_preprocess_block()
 * @see manzanita_theme_suggestions_block_alter()
 */
#}
{% set classes = [
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
  'block--type-' ~ bundle|clean_class,
  'block--view-mode-' ~ view_mode|clean_class,
  'osu-card',
  'osu-card--picbox',
] %}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  <div class="picbox-container">
    <div class="picbox-item">
      <div class="picbox-media">
        {% if card_url and card_title %}
          <a href="{{ card_url }}" class="picbox-link">
            <h3 class="picbox-headline text-uppercase">{{ card_title }}</h3>
          </a>
          {{ card_image }}
        {% elseif card_url %}
          <a href="{{ card_url }}" class="picbox-link">
            {{ card_image }}
          </a>
        {% else %}
          {% if card_title %}
            <h3 class="picbox-headline text-uppercase">{{ card_title }}</h3>
          {% endif %}
          {{ card_image }}
        {% endif %}
      </div>
      {{ card_description }}
    </div>
  </div>
</div>
