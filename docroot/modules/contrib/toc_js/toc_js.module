<?php

/**
 * @file
 * Contains toc_js.module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeTypeInterface;
use Drupal\toc_js\Hook\TocJsHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function toc_js_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(TocJsHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function toc_js_theme($existing, $type, $theme, $path) {
  return \Drupal::service(TocJsHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Prepares variables for table of contents theme.
 *
 * Default template: toc-js.html.twig.
 *
 * @param array $variables
 *   An associative array containing the following keys:
 *   - entity: the entity the TOC belongs to.
 *   - title: the TOC title.
 *   - tag: the tag title.
 */
function template_preprocess_toc_js(&$variables) {
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
#[LegacyHook]
function toc_js_theme_suggestions_toc_js_alter(array &$suggestions, array $variables) {
  \Drupal::service(TocJsHooks::class)->themeSuggestionsTocJsAlter($suggestions, $variables);
}

/**
 * Implements hook_entity_extra_field_info().
 */
#[LegacyHook]
function toc_js_entity_extra_field_info() {
  return \Drupal::service(TocJsHooks::class)->entityExtraFieldInfo();
}

/**
 * Implements hook_ENTITY_TYPE_view() for node entities.
 */
#[LegacyHook]
function toc_js_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  \Drupal::service(TocJsHooks::class)->nodeView($build, $entity, $display, $view_mode);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function toc_js_form_node_type_form_alter(&$form, FormStateInterface $form_state) {
  \Drupal::service(TocJsHooks::class)->formNodeTypeFormAlter($form, $form_state);
}

/**
 * Entity builder for the node type form with TOC option.
 */
function toc_js_form_node_type_form_builder($entity_type, NodeTypeInterface $type, &$form, FormStateInterface $form_state) {
  TocJsHooks::formNodeTypeFormBuilder($entity_type, $type, $form, $form_state);
}
