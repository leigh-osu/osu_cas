{
    "name": "drupal/entityreference_filter",
    "description": "Provides views-based filter for entity reference and entity id fields in views.",
    "type": "drupal-module",
    "homepage": "https://drupal.org/project/entityreference_filter",
    "authors": [
        {
            "name": "Maxim Podorov",
            "role": "Maintainer"
        },
        {
            "name": "Maxim Kashuba",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/entityreference_filter",
        "source": "https://git.drupalcode.org/project/entityreference_filter"
    },
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10.3 || ^11"
    },
    "require-dev": {
        "drupal/better_exposed_filters": "^6 || ^7",
        "drupal/search_api": "^1"
    },
    "suggest": {
        "drupal/better_exposed_filters": "Allows rewriting of filter options via BEF settings.",
        "drupal/search_api": "Enables the Search API integration submodule with the Search API variant of the filter."
    }
}
